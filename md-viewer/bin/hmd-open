#!/usr/bin/env bash
# hmd-open <path> [ignored-cwd]: for iTerm Semantic History. Opens a .md path in a herdr pane
# beside the focused pane. Relative paths resolve against the focused pane's cwd.
echo "$(date +%T) args: $*" >> /tmp/hmd-open.log
# The clicked pane is not necessarily focused (iTerm eats Cmd+click, herdr never sees it), so the
# target is the pane in the focused pane's tab that shows the clicked text and where the path exists.
# HMD_TARGET_PANE forces the target pane; HMD_FOCUSED_PANE fakes the focused pane (both for testing).
set -uo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
raw="${1:-}"; [ -n "$raw" ] || exit 2
H="${HERDR_BIN_PATH:-$(command -v herdr)}"
read -r pane p < <(HERDR="$H" python3 - "$raw" <<'EOF'
import json, os, subprocess, sys
raw = sys.argv[1]
H = os.environ["HERDR"]
def herdr(*a):
    return subprocess.run([H, *a], capture_output=True, text=True).stdout
rel = raw.split(":")[0] if not raw.startswith("file://") else raw[7:]
rel = os.path.expanduser(rel)
panes = json.loads(herdr("pane", "list"))["result"]["panes"]
forced = os.environ.get("HMD_TARGET_PANE")
focused = os.environ.get("HMD_FOCUSED_PANE") or next((p["pane_id"] for p in panes if p.get("focused")), None)
if forced:
    cands = [p for p in panes if p["pane_id"] == forced]
else:
    tab = next((p["tab_id"] for p in panes if p["pane_id"] == focused), None)
    cands = sorted((p for p in panes if p["tab_id"] == tab), key=lambda p: p["pane_id"] != focused)
def resolve(p):
    return os.path.normpath(os.path.join(p.get("foreground_cwd") or p["cwd"], rel))
def shows(p):
    return raw in herdr("pane", "read", p["pane_id"], "--source", "visible")
exists = [p for p in cands if os.path.exists(resolve(p))]
pick = next((p for p in exists if shows(p)), None) or (exists[0] if exists else None) \
    or next((p for p in cands if shows(p)), None) or (cands[0] if cands else None)
if pick:
    print(pick["pane_id"], resolve(pick))
EOF
)
[ -n "${pane:-}" ] || { echo "$(date +%T) no target pane for $raw" >> /tmp/hmd-open.log; exit 1; }
echo "$(date +%T) pane $pane -> $p" >> /tmp/hmd-open.log
if [ -d "$p" ]; then   # directory: open its newest .md (README.md wins ties by recency only)
  newest=$(ls -t "$p"/*.md "$p"/*.markdown 2>/dev/null | head -1)
  echo "$(date +%T) dir $p -> ${newest:-none}" >> /tmp/hmd-open.log
  if [ -z "$newest" ]; then osascript -e "display notification \"no .md in $p\" with title \"hmd\"" 2>/dev/null; exit 0; fi
  p="$newest"
fi
if [ ! -f "$p" ]; then echo "$(date +%T) not a file: $p (raw: $raw)" >> /tmp/hmd-open.log; osascript -e "display notification \"not found: $p\" with title \"hmd\"" 2>/dev/null; exit 1; fi
case "$p" in *.md|*.markdown) ;; *) exec open "$p";; esac   # non-markdown: macOS default app
HERDR_ENV=1 HERDR_PANE_ID="$pane" HERDR_WORKSPACE_ID="${pane%%:*}" exec "$HOME/.local/bin/hmd" "$p"
